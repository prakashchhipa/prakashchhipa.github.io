---
layout: default
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
>
<style>
  /* Editorial founder theme, matched to the new portfolio (prakashchhipa.ai).
     Tokens are set on <html> for this page only, so the navbar and footer follow. */
  html:has(.pf) {
    --pf-bg: #f7f3ec;
    --pf-elev: #efe8dc;
    --pf-ink: #1b1916;
    --pf-soft: rgba(27, 25, 22, 0.74);
    --pf-mute: rgba(27, 25, 22, 0.58);
    --pf-rule: rgba(27, 25, 22, 0.14);
    --pf-accent: #9a5b22;
    --pf-accent-soft: rgba(154, 91, 34, 0.12);
    --pf-glow: rgba(196, 128, 64, 0.16);
    --global-bg-color: var(--pf-bg);
    --global-text-color: var(--pf-ink);
    --global-text-color-light: var(--pf-mute);
    --global-theme-color: var(--pf-accent);
    --global-hover-color: var(--pf-accent);
    --global-footer-bg-color: var(--pf-elev);
    --global-footer-text-color: var(--pf-soft);
    --global-footer-link-color: var(--pf-ink);
    --global-divider-color: var(--pf-rule);
  }
  html[data-theme='dark']:has(.pf) {
    --pf-bg: #0e0d0c;
    --pf-elev: #1a1816;
    --pf-ink: #f4f1eb;
    --pf-soft: rgba(244, 241, 235, 0.72);
    --pf-mute: rgba(244, 241, 235, 0.58);
    --pf-rule: rgba(244, 241, 235, 0.12);
    --pf-accent: #d4a574;
    --pf-accent-soft: rgba(212, 165, 116, 0.15);
    --pf-glow: rgba(212, 165, 116, 0.15);
  }
  html:has(.pf) body { background: var(--pf-bg); color: var(--pf-ink); }
  html:has(.pf) .navbar { background: var(--pf-bg) !important; border-bottom: 1px solid var(--pf-rule); }
  .container:has(> .pf) { max-width: 1180px; }

  .pf { font-family: 'Inter', system-ui, sans-serif; color: var(--pf-ink); font-feature-settings: 'ss01', 'cv11'; }
  .pf ::selection { background: var(--pf-accent-soft); }
  .pf a { color: var(--pf-accent); text-decoration: none; }
  .pf a:hover { color: var(--pf-ink); }
  .pf section { padding: 72px 0; border-bottom: 1px solid var(--pf-rule); }
  .pf section:last-child { border-bottom: 0; }
  .pf .serif { font-family: 'Fraunces', Georgia, serif; font-variation-settings: 'opsz' 144; }
  .pf em { font-style: italic; color: var(--pf-accent); font-weight: 300; }
  .pf .eyebrow { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--pf-accent); }
  .pf .pf-cap { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--pf-mute); }
  .pf h1, .pf h2, .pf h3 { font-family: 'Fraunces', Georgia, serif; font-weight: 400; color: var(--pf-ink); font-variation-settings: 'opsz' 144; }
  .pf h2 { font-size: clamp(30px, 4vw, 44px); line-height: 1.1; letter-spacing: -0.018em; margin: 14px 0 18px; }
  .pf h3 { font-size: 24px; line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 10px; }
  .pf .lede { font-family: 'Fraunces', Georgia, serif; font-weight: 300; font-size: clamp(18px, 2vw, 21px); line-height: 1.55; color: var(--pf-soft); max-width: 780px; margin-bottom: 40px; }
  .pf p { color: var(--pf-soft); line-height: 1.65; }
  .pf strong { color: var(--pf-ink); font-weight: 500; }
  .pf .link { font-size: 14px; border-bottom: 1px solid currentColor; padding-bottom: 3px; display: inline-block; }
  .pf .link.quiet { color: var(--pf-soft); border-color: var(--pf-rule); }
  .pf .link:hover { color: var(--pf-ink); }

  /* Hero */
  .pf-hero { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; padding-top: 24px !important; }
  html:has(.pf) body { overflow-x: clip; }
  .pf-hero > *, .pf-feature > *, .pf-research > * { min-width: 0; }
  .pf-hero::before { content: ''; position: absolute; top: -220px; right: -220px; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, var(--pf-glow) 0%, transparent 70%); pointer-events: none; }
  .pf-hero > * { position: relative; }
  .pf-hero h1 { font-size: clamp(38px, 5.2vw, 64px); line-height: 1.05; letter-spacing: -0.022em; margin: 28px 0 30px; }
  .pf-hero .intro { font-size: 17px; line-height: 1.6; max-width: 560px; margin-bottom: 34px; }
  .pf-ctas { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; }
  .pf-now { margin-top: 36px; display: inline-flex; gap: 12px; align-items: center; padding: 10px 16px; border: 1px solid var(--pf-rule); font-size: 14px; color: var(--pf-soft); }
  .pf-now .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--pf-accent); box-shadow: 0 0 0 0 var(--pf-accent); animation: pf-pulse 2.4s ease-in-out infinite; flex: none; }
  @keyframes pf-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .pf-portrait { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--pf-elev); margin: 0; }
  .pf-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: center 78%; filter: contrast(1.05) saturate(0.85); }
  .pf-portrait::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 55%, rgba(0, 0, 0, 0.55)); }
  .pf-portrait figcaption { position: absolute; left: 20px; right: 20px; bottom: 18px; z-index: 1; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }

  /* Numbers */
  .pf-numbers { display: grid; grid-template-columns: repeat(6, 1fr); padding: 48px 0 !important; }
  .pf-numbers > div { padding: 0 20px; border-right: 1px solid var(--pf-rule); }
  .pf-numbers > div:first-child { padding-left: 0; }
  .pf-numbers > div:last-child { border-right: 0; }
  .pf-num { font-family: 'Fraunces', Georgia, serif; font-weight: 300; font-size: 52px; line-height: 1; letter-spacing: -0.03em; color: var(--pf-ink); margin-bottom: 12px; font-variation-settings: 'opsz' 144; }
  .pf-num span { font-family: "Inter", sans-serif; font-weight: 400; font-size: 30px; color: var(--pf-accent); margin-left: 3px; vertical-align: 10px; }
  .pf-numbers .label { font-size: 13px; font-weight: 500; color: var(--pf-ink); line-height: 1.45; }
  .pf-numbers .detail { font-size: 12px; color: var(--pf-mute); line-height: 1.45; margin-top: 4px; }

  /* Grids and cards */
  .pf-grid { display: grid; gap: 1px; background: var(--pf-rule); border: 1px solid var(--pf-rule); }
  .pf-grid.g3 { grid-template-columns: repeat(3, 1fr); }
  .pf-card { background: var(--pf-bg); padding: 30px 28px; display: flex; flex-direction: column; }
  .pf-card .q { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 300; font-size: 18px; line-height: 1.45; color: var(--pf-ink); margin: 6px 0 16px; }
  .pf-card p { font-size: 14.5px; }
  .pf-kr { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--pf-rule); display: grid; gap: 12px; }
  .pf-kr div { display: grid; grid-template-columns: 88px 1fr; gap: 12px; align-items: baseline; }
  .pf-kr b { font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: 24px; color: var(--pf-accent); letter-spacing: -0.02em; }
  .pf-kr span { font-size: 12.5px; color: var(--pf-mute); line-height: 1.4; }
  .pf-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .pf-stack span { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.04em; padding: 4px 8px; border: 1px solid var(--pf-rule); color: var(--pf-soft); }

  /* PlayPrismAI feature */
  .pf-feature { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: start; }
  .pf-problem { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--pf-rule); border: 1px solid var(--pf-rule); margin: 4px 0 30px; }
  .pf-problem div { background: var(--pf-bg); padding: 18px 16px; }
  .pf-problem b { display: block; font-family: 'Fraunces', Georgia, serif; font-weight: 300; font-size: 30px; color: var(--pf-ink); letter-spacing: -0.02em; line-height: 1.1; }
  .pf-problem span { font-size: 12px; color: var(--pf-mute); line-height: 1.4; display: block; margin-top: 6px; }
  .pf-steps { list-style: none; counter-reset: s; padding: 0; margin: 0 0 26px; border-top: 1px solid var(--pf-rule); }
  .pf-steps li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; padding: 13px 0; border-bottom: 1px solid var(--pf-rule); font-size: 14.5px; color: var(--pf-soft); line-height: 1.5; }
  .pf-steps li::before { content: '0' counter(s); font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--pf-accent); padding-top: 3px; }
  .pf-shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; }
  .pf-shot { margin: 0; border: 1px solid var(--pf-rule); background: var(--pf-elev); overflow: hidden; }
  .pf-shot img { display: block; width: 100%; height: auto; transition: transform 0.4s ease; }
  .pf-shot:hover img { transform: scale(1.03); }
  .pf-shot figcaption { padding: 9px 10px; }
  .pf-pull { border-left: 2px solid var(--pf-accent); padding: 4px 0 4px 18px; font-family: 'Fraunces', Georgia, serif; font-size: 19px; font-weight: 300; line-height: 1.45; color: var(--pf-ink); margin: 0 0 24px; }

  /* Delta bar */
  .pf-delta { margin: 6px 0 4px; }
  .pf-delta .bar { position: relative; height: 6px; background: var(--pf-rule); margin: 8px 0 6px; }
  .pf-delta .bar i { position: absolute; inset: 0 auto 0 0; background: var(--pf-mute); }
  .pf-delta .bar i + i { background: var(--pf-accent); opacity: 0.9; }
  .pf-delta .row { display: flex; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--pf-mute); }

  /* Career path */
  .pf-path { border-top: 1px solid var(--pf-rule); }
  .pf-path > div { display: grid; grid-template-columns: 130px 280px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--pf-rule); align-items: baseline; }
  .pf-path .yr { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--pf-accent); letter-spacing: 0.06em; }
  .pf-path .org { font-family: 'Fraunces', Georgia, serif; font-size: 21px; color: var(--pf-ink); line-height: 1.25; }
  .pf-path .org small { display: block; font-family: 'Inter', sans-serif; font-size: 13px; color: var(--pf-mute); margin-top: 4px; }
  .pf-path p { margin: 0; font-size: 14.5px; }

  /* Papers + news */
  .pf-research { display: grid; grid-template-columns: 1fr 330px; gap: 56px; }
  .pf .publications, .pf .news { font-size: 14px; }
  .pf .publications h2.bibliography, .pf .publications .bibliography > li { border-color: var(--pf-rule); }
  .pf .publications .title { font-family: 'Fraunces', Georgia, serif; font-size: 17px; font-weight: 400; color: var(--pf-ink); }
  .pf .publications .abbr abbr, .pf .publications .abbr .badge { background: var(--pf-accent) !important; color: var(--pf-bg) !important; border-radius: 0; font-family: 'JetBrains Mono', monospace; font-weight: 400; }
  .pf .publications .author, .pf .publications .periodical { color: var(--pf-soft); }
  .pf .publications .links a.btn { border-color: var(--pf-rule); color: var(--pf-soft); border-radius: 0; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; }
  .pf .publications .links a.btn:hover { color: var(--pf-accent); border-color: var(--pf-accent); }
  .pf .news .table { color: var(--pf-soft); margin: 0; }
  .pf .news tr { display: block; padding: 14px 0; border-bottom: 1px solid var(--pf-rule); }
  .pf .news tr:first-child { border-top: 1px solid var(--pf-rule); }
  .pf .news th, .pf .news td { display: block; width: auto !important; padding: 0; border: 0; }
  .pf .news th { font-family: 'JetBrains Mono', monospace; font-weight: 400; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--pf-accent); margin-bottom: 6px; }
  .pf .news td { font-size: 14px; line-height: 1.55; }
  .pf .news .table-responsive { max-height: 720px !important; overflow-y: auto; }

  /* Travels */
  .pf-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .pf-tiles figure { margin: 0; }
  .pf-tiles .img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--pf-elev); }
  .pf-tiles img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85); transition: transform 0.4s ease; }
  .pf-tiles figure:hover img { transform: scale(1.04); }
  .pf-tiles figcaption { padding-top: 10px; }
  .pf-tiles figcaption b { display: block; font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: 17px; color: var(--pf-ink); }

  /* Contact */
  .pf-contact h2 { font-size: clamp(32px, 4.6vw, 54px); }
  .pf-paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--pf-rule); border: 1px solid var(--pf-rule); margin: 8px 0 36px; }
  .pf-paths div { background: var(--pf-bg); padding: 26px 24px; }
  .pf-paths p { font-size: 14.5px; margin: 8px 0 0; }
  .pf-paths .serif { font-size: 20px; color: var(--pf-ink); line-height: 1.3; }
  .pf .social { padding: 0; }
  .pf .contact-icons { text-align: left; font-size: 28px; }
  .pf .contact-icons a { color: var(--pf-soft); margin-right: 14px; }
  .pf .contact-icons a:hover { color: var(--pf-accent); }
  .pf-logos { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; margin-top: 32px; }
  .pf-logos img { height: 56px; width: auto; border-radius: 2px; }

  @media (max-width: 991px) {
    .pf-hero, .pf-feature, .pf-research { grid-template-columns: 1fr; gap: 40px; }
    .pf-hero .pf-portrait { max-width: 440px; }
    .pf-numbers { grid-template-columns: repeat(3, 1fr); row-gap: 36px; }
    .pf-numbers > div:nth-child(3n) { border-right: 0; }
    .pf-numbers > div:nth-child(3n + 1) { padding-left: 0; }
    .pf-grid.g3, .pf-paths { grid-template-columns: 1fr; }
    .pf-tiles { grid-template-columns: repeat(2, 1fr); }
    .pf-path > div { grid-template-columns: 110px 1fr; }
    .pf-path p { grid-column: 2; }
  }
  @media (max-width: 575px) {
    .pf section { padding: 52px 0; }
    .pf-numbers { grid-template-columns: repeat(2, 1fr); }
    .pf-numbers > div { border-right: 0 !important; padding: 0 12px 0 0 !important; }
    .pf-problem, .pf-shots { grid-template-columns: 1fr; }
    .pf-path > div { grid-template-columns: 1fr; gap: 6px; }
    .pf-path p { grid-column: auto; }
    .pf-kr div { grid-template-columns: 76px 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pf * { animation: none !important; transition: none !important; }
  }
</style>

<div class="pf">
  {{ content }}
</div>
